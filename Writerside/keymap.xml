<?xml version="1.0" encoding="UTF-8"?>
<keymap id="intellij_default">
    <layouts>
        <layout name="Windows" platform="PC"/>
        <layout name="macOS" platform="MAC"/>
        <layout name="Linux" platform="PC"/>
    </layouts>
    <actions>
        <action id="$Generate">
            <description>Generate</description>
            <shortcut layout="Windows">Alt+Insert</shortcut>
            <shortcut layout="macOS">&#8984; N</shortcut>
            <shortcut layout="Linux">Alt+Insert</shortcut>
        </action>
        <action id="$ShowIntentionActions">
            <description>Show context actions</description>
            <shortcut layout="Windows">Alt+Enter</shortcut>
            <shortcut layout="macOS">&#8997;&#9166;</shortcut>
            <shortcut layout="Linux">Alt+Enter</shortcut>
        </action>
        <action id="$ShowSettings">
            <description>Open IDE settings</description>
            <shortcut layout="Windows">Ctrl+Alt+S</shortcut>
            <shortcut layout="macOS">&#8984;,</shortcut>
            <shortcut layout="Linux">Ctrl+Alt+S</shortcut>
        </action>
    </actions>
</keymap>
