# Editor defaults, so that a contributor's IDE produces text the build already agrees with.
# Checkstyle is the authority — see build-config/checkstyle.xml — and this file only keeps an
# editor from fighting it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Checkstyle's LineLength rule, restated where an editor can act on it.
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

# Tab-separated. An editor that helpfully expands these to spaces breaks the documentation gate,
# which splits every row on the tab character.
[*.tsv]
indent_style = tab

[*.{xml,topic,tree,list}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.bat]
end_of_line = crlf
