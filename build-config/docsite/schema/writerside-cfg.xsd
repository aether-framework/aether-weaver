<!--suppress XmlDefaultAttributeValue -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0">
    <xs:element name="module">
        <xs:annotation>
            <xs:documentation>
                <p>Specify settings for the help module.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="name">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the name of the help module.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="settings">
        <xs:annotation>
            <xs:documentation>
                <p>Specify additional help module settings.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element ref="caps" minOccurs="0"/>
                <xs:element ref="default-property" minOccurs="0"/>
                <xs:element ref="wrs-supernova" minOccurs="0" maxOccurs="1"/>
                <xs:element name="id-generator-method" type="xs:string" minOccurs="0">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                Writerside generates synthetic IDs for chapters in Markdown based on the title.
                                This ensures that you can reference any chapter in a Markdown topic
                                without having to set an explicit ID for it.</p>
                            <p>
                                This setting controls the method used for converting titles to IDs:</p>
                            <ul>
                                <li>
                                    <code>LOWER_CASE_DASHES</code> is the default value
                                    that replaces all non-alphanumeric and non-ASCII characters with dashes,
                                    combines sequential dashes,
                                    and removes leading and trailing dashes.</li>
                                <li>
                                    <code>LOWER_CASE_DASHES_DOT_REMOVE</code> is the same as above,
                                    but also removes all dots.</li>
                                <li>
                                    <code>LOWER_CASE_DASHES_INTERNATIONAL</code> is the same as above,
                                    but preserves non-ASCII characters from Unicode.</li>
                                <li>
                                    <code>URL_ENCODE_PLUS</code> translates the string
                                    into <code>x-www-form-urlencoded</code> format using UTF-8.</li>
                                <li>
                                    <code>URL_ENCODE_PERCENT</code> is the same as above,
                                    but also replaces plus characters '<code>+</code>' with '<code>%20</code>'.</li>
                            </ul>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="disable-web-name-preprocessing" type="xs:boolean" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                Specify whether web file names should be normalized.
                                By default, Writerside replaces all special characters with hyphens
                                and lowercases all other characters in the topic file name
                                to produce a normalized web file name.
                                For example, <code>My___Awesome.topic</code>
                                becomes <code>my-awesome.html</code>.</p>
                            <p>
                                If you want to keep the web file names similar to topic file names
                                (only replace characters that are not allowed in URLs),
                                set <code>&lt;disable-web-name-preprocessing&gt;true&lt;/disable-web-name-preprocessing&gt;</code>.
                            </p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="smart-ignore-vars" type="xs:boolean" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>
                            <p>
                                Do not interpolate variables in code blocks and URLs.</p>
                            <p>
                                By default, Writerside resolves <code>%var%</code> variables
                                in code blocks, links to URLs, and external image references,
                                unless the user sets <code>ignore-vars="true"</code>.</p>
                            <p>
                                Set <code>&lt;smart-ignore-vars&gt;true&lt;/smart-ignore-vars&gt;</code>
                                to change the default behavior
                                and insert variables literally
                                without interpolating them.
                                In this case, you can set <code>ignore-vars="false"</code>
                                on code blocks, external links, and image references
                                where you want to resolve the variables.</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>

    <xs:element name="ihp">
        <xs:annotation>
            <xs:documentation>
                <p>This is the root element.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="settings" minOccurs="0"/>
                <xs:element ref="module" minOccurs="0"/>
                <xs:element ref="topics"/>
                <xs:element ref="images"/>
                <xs:element ref="api-specifications"/>
                <xs:element ref="categories" minOccurs="0"/>
                <xs:element ref="vars" minOccurs="0"/>
                <xs:element ref="snippets" minOccurs="0"/>
                <xs:element ref="instance" maxOccurs="unbounded"/>
                <xs:element ref="build-config" minOccurs="0"/>
                <xs:element ref="instance-groups" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute type="xs:string" name="version">
                <xs:annotation>
                    <xs:documentation>
                        <p>Set the global version for all help instances in this help module.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="default-property">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the default properties for the particular markup elements.
                    This setting is applied to all topics unless you explicitly override it by defining it on the topic level.
                </p>

<pre>
    &lt;default-property element-name="img" property-name="border-effect" value="line"/&gt;
</pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="element-name">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify which elements the attribute will be applied to.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="property-name">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the attribute name to which this default value will be applied.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="value">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the default attribute value.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="wrs-supernova">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the version of the Docker help builder in the 'use-version' attribute.
                    Your CI/CD scripts can use this value to determine which builder version should be used.
                    For example:
                </p>

<pre>
    &lt;wrs-supernova use-version="2.1.1477-p3867"/&gt;
</pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="use-version" use="required">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the version of the help builder.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="topics">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the name of the directory where topic files are located.
                    By default, it is <code>topics/</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="dir">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify a directory in the help module root.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="images">
        <xs:annotation>
            <xs:documentation>
                <p>Specify the image directory settings.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="dir">
                        <xs:annotation>
                            <xs:documentation>
                                <p>
                                    Specify the name of the directory where media files
                                    (images, GIFs, and videos) are stored.
                                    By default, it is <code>images/</code>.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="version" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the image set version.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="web-path" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the path where images should be located once the help instance is built.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="teamcity-build-path" use="optional"/>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="api-specifications">
        <xs:annotation>
            <xs:documentation>
                <p>Specify the designated directory for API specifications.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="dir">
                        <xs:annotation>
                            <xs:documentation>
                                <p>
                                    Specify the name of the directory where API specification files are stored.
                                    By default, it is <code>specifications/</code>.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="categories">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the name of the file
                    where you put the list of categories for grouping related links in the seealso section.
                    By default, it is <code>c.list</code>.
                </p>
<pre>
    &lt;categories src="c.list"/&gt;
</pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="src">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the name of the file.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="vars">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the name of the file where you put variables and their values.
                    By default, it is <code>v.list</code>.
                </p>
<pre>
    &lt;vars src="v.list"/&gt;
</pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="src">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the file in the help module root.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="caps">
        <xs:annotation>
            <xs:documentation>
                <p>Specify in which capitalization style to display titles.</p>
<pre>
    &lt;caps style="title" for="toc-element"/&gt;
</pre>
                <p>In this case, titles in the table of contents will be rendered in title case.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="style" use="required">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Choose between <code>sentence</code>, <code>title</code>, and <code>aswritten</code>.</p>
                            </xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="sentence"/>
                                <xs:enumeration value="title"/>
                                <xs:enumeration value="aswritten"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="for">
                        <xs:annotation>
                            <xs:documentation>
                                <p>
                                    Specify the elements for which you want to apply the capitalization style,
                                    such as <code>toc-element</code>, <code>topic</code>, or <code>chapter</code>.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="snippets">
        <xs:annotation>
            <xs:documentation>
                <p>Specify the name of the directory where you put code snippets.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="src">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify a directory in the help module root.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="instance">
        <xs:annotation>
            <xs:documentation>
                <p>Specify the settings for a help instance.</p>
<pre>
    &lt;instance src="pd.tree" web-path="/plugin-developers/" version="main"/&gt;
</pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute type="xs:string" name="src">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the <code>.tree</code> file name of the help instance.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="web-path" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <p>
                                    Specify the path that will be the last part of the URL for a particular help instance
                                    after it is built.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute type="xs:string" name="version" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the help instance version displayed in the website header.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="keymaps-mode" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Specify the mode for the keymap file:</p>
                                <ul>
                                    <li><code>none</code> if there is no keymap file</li>
                                    <li><code>generated</code> if the keymap file is automatically generated</li>
                                    <li><code>provided</code> if the keymap file is configured manually</li>
                                </ul>
                            </xs:documentation>
                        </xs:annotation>
                        <xs:simpleType>
                            <xs:restriction base="xs:string">
                                <xs:enumeration value="generated"/>
                                <xs:enumeration value="provided"/>
                                <xs:enumeration value="none"/>
                            </xs:restriction>
                        </xs:simpleType>
                    </xs:attribute>
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>
    <xs:element name="build-config">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the name of the directory for build configuration files,
                    such as <code>buildprofiles.xml</code> and <code>build-script.xml</code>.
                    By default, it is set to <code>cfg/</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute type="xs:string" name="dir" use="required">
                <xs:annotation>
                    <xs:documentation>
                        <p>
                            Specify the build configuration directory in the module root,
                            that is, on the same level as <code>writerside.cfg</code>.
                            For example: <code>&lt;build-config dir="custom-cfg-dir"/&gt;</code>.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="instance-groups">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify the name of a file where instance groups are declared,
                    e.g., <code>instance-groups.xml</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute type="xs:string" name="src" use="required">
                <xs:annotation>
                    <xs:documentation>
                        <p>
                            Specify the name of a file in the module root,
                            that is, on the same level as <code>writerside.cfg</code>.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
