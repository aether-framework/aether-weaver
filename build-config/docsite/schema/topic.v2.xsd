<?xml version="1.0" encoding ="UTF-8"?>
<!--suppress XmlDefaultAttributeValue -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.1"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1">

    <xs:element name="api-doc">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Generate API reference from an OpenAPI specification file.
                    You can generate a full reference or only the operations and webhooks marked with a specific tag.
                </p>

                <p>Here is how to generate the full API reference:</p>

                <pre>
                    <code>&lt;api-doc openapi-path="path/to/file.yaml"/&gt;</code>
                </pre>

                <p>Here is how to generate a reference of operations and webhooks marked with the <code>User</code> tag:
                </p>

                <pre>
                    <code>&lt;api-doc openapi-path="path/to/file.yaml" tag="User"/&gt;</code>
                </pre>

                <p>Here is how to generate a reference with operations only:
                </p>

                <pre>
                    <code>&lt;api-doc openapi-path="path/to/file.yaml" display="operations"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="api-endpoint" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="api-webhook" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="display-links-if-available" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether to display links to corresponding API schema objects when possible.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="display" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether to display all operations and webhooks, only operations or only webhooks.</p>

                        <p>
                            You can use one of the following values:
                        </p>

                        <ul>
                            <li>
                                <code>all</code>
                                (default) - generate reference for all endpoints and webhooks
                            </li>
                            <li>
                                <code>endpoints</code>
                                - generate reference for endpoints only
                            </li>
                            <li>
                                <code>webhooks</code>
                                - generate reference for webhooks only
                            </li>
                        </ul>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="openapi-path" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the path to the OpenAPI specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="tag" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Generate API reference only for operations and webhooks marked with this tag.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="depth" use="optional"/>
            <xs:attribute name="generate-samples" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Generate samples of requests and responses from the specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="api-endpoint">
        <xs:annotation>
            <xs:documentation>
                <p>Generate a reference for a single API endpoint and its HTTP method (operation).</p>

                <pre>
                    <code>&lt;api-endpoint openapi-path="path/to/file.yaml" endpoint="/users" method="GET"/&gt;</code>
                </pre>

                <p>
                    You can generate a reference for several endpoints and methods.
                    In this case, put them inside the <code>&lt;api-doc&gt;</code> element to define the path to the
                    spec only once:
                </p>

                <pre>
                    <code>
                        &lt;api-doc openapi-path="path/to/file.yaml"&gt;
                        &lt;api-endpoint endpoint="/users" method="GET"/&gt;
                        &lt;api-endpoint endpoint="/users" method="POST"/&gt;
                        &lt;/api-doc&gt;
                    </code>
                </pre>

                <p>
                    By default, Writerside generates request and response samples from the spec.
                    You can provide custom samples inside the <code>&lt;api-endpoint&gt;</code> tag
                    using <code>&lt;request&gt;</code> and <code>&lt;response&gt;</code> tags.
                    To prevent generating samples without the need to provide custom ones,
                    set the <code>generate-samples</code> attribute to <code>none</code>:
                </p>

                <pre>
                    <code>&lt;api-endpoint endpoint="/users" method="GET" generate-samples="none"/&gt;</code>
                </pre>

                <p>
                    You can use one of the following values:
                </p>

                <ul>
                    <li>
                        <code>ALL</code>
                        (default) - generate samples for all requests and responses
                    </li>
                    <li>
                        <code>REQUEST</code>
                        - generate samples for requests only
                    </li>
                    <li>
                        <code>RESPONSE</code>
                        - generate samples for responses only
                    </li>
                    <li>
                        <code>NONE</code>
                        - do not generate samples
                    </li>
                </ul>

                <pre>
                    <code>&lt;api-endpoint endpoint="/users" method="GET" generate-samples="request"/&gt;</code>
                </pre>

                <p>
                    You can also specify the depth of the generated reference using the <code>depth</code> attribute.
                    The depth defines how many levels of nested objects to include in the reference.
                    The default value is <code>null</code> (all levels).
                </p>

                <pre>
                    <code>&lt;api-endpoint endpoint="/users" method="GET" depth="null"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="request" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="response" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="display-links-if-available" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether to display links to corresponding API schema objects when possible.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="openapi-path" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the path to the OpenAPI specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="endpoint" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the endpoint for which you want to generate reference.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="method" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the method for which you want to generate reference.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="depth" use="optional"/>
            <xs:attribute name="generate-samples" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Generate samples of requests and responses from the specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
    <xs:element name="api-webhook">
        <xs:annotation>
            <xs:documentation>
                <p>Generate a reference for a single API webhook.</p>

                <pre>
                    <code>
                        &lt;api-webhook openapi-path="path/to/file.yaml" webhook="NewWebHook" method="POST"/&gt;
                    </code>
                </pre>

                <p>
                    You can generate a reference for several endpoints and webhooks at the same time.
                    In this case, put them inside the <code>&lt;api-doc&gt;</code> element to define the path to the
                    spec only once:
                </p>

                <pre>
                    <code>
                        &lt;api-doc openapi-path="path/to/file.yaml"&gt;
                        &lt;api-endpoint endpoint="/users" method="GET"/&gt;
                        &lt;api-endpoint endpoint="/users" method="POST"/&gt;
                        &lt;api-webhooks webhook="NewWebHook" method="POST"/&gt;
                        &lt;/api-doc&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="request" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="response" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="display-links-if-available" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether to display links to corresponding API schema objects when possible.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="openapi-path" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the path to the OpenAPI specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="webhook" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the name of webhook for which you want to generate reference.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="method" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the method for which you want to generate reference.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="depth" use="optional"/>
            <xs:attribute name="generate-samples" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Generate samples of requests and responses from the specification.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="request">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify request information within an
                    <code>&lt;api-endpoint&gt;</code>
                    tag to provide developers with a clear understanding
                    of the expected input and structure when making requests to an API endpoint.
                </p>
                <p>
                    The <code>&lt;request&gt;</code> tag is exclusively used within the context of an
                    <code>&lt;api-endpoint&gt;</code>
                    to describe the expected request structure. It can contain one or more <code>&lt;sample&gt;</code> tags
                    to
                    illustrate various request examples for different languages.
                </p>
                <p>
                    Here's an example of how to use the <code>&lt;request&gt;</code> tag within an <code>&lt;api-endpoint&gt;</code>:
                </p>
                <pre>
                    <code>
                        &lt;api-endpoint endpoint="/users" method="POST"&gt;
                        &lt;request&gt;
                        &lt;sample lang="JSON" title="Payload"&gt;
                        {
                        "id": 123,
                        "name": "John Doe",
                        "email": "john.doe@example.com"
                        }
                        &lt;/sample&gt;
                        &lt;sample lang="javascript" title="JavaScript"&gt;
                        const data = {
                        id: 123,
                        name: "John Doe",
                        email: "john.doe@example.com"
                        };
                        &lt;/sample&gt;
                        &lt;/request&gt;
                        &lt;/api-endpoint&gt;
                    </code>
                </pre>

                <p>This example defines two request samples: JSON and JavaScript.</p>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType>
            <xs:sequence>
                <xs:element ref="sample" minOccurs="0" maxOccurs="1"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="response">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Specify response information for an API endpoint.
                    This tag must define a required attribute <code>type</code> to specify the response code (e.g.,
                    default, 1XX, 2XX, 4XX, 5XX).
                </p>
                <p>
                    You can include a <code>&lt;sample&gt;</code> tag to provide sample response data.
                    Here's an example of how to use this tag:
                </p>
                <pre>
                    <code>
                        &lt;api-endpoint endpoint="/users/{id}" method="GET"&gt;
                        &lt;response type="200"&gt;
                        &lt;sample&gt;
                        {
                        "id": 123,
                        "name": "John Doe",
                        "email": "john.doe@example.com"
                        }
                        &lt;/sample&gt;
                        &lt;/response&gt;
                        &lt;response type="400"&gt;
                        &lt;sample&gt;
                        {
                        "error": "text"
                        }
                        &lt;/sample&gt;
                        &lt;/response&gt;
                        &lt;/api-endpoint&gt;
                    </code>
                </pre>

                <p>
                    This example defines an <code>&lt;api-endpoint&gt;</code> for retrieving user details by ID.
                    There are two <code>&lt;response&gt;</code> tags to describe potential responses:
                    one for a successful response with the status code of 200 and another for an error response with the
                    status code 400.
                </p>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType>
            <xs:sequence>
                <xs:element ref="sample" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="type" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the response code.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="sample">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Define a custom request or response example to help developers
                    understand the expected input and output of an API endpoint.
                </p>
                <p>
                    Use the <code>&lt;sample&gt;</code> tag inside a <code>&lt;request&gt;</code> or a <code>&lt;response&gt;</code> tag.
                </p>

                <p>
                    For request samples, use the optional <code>lang</code> attribute for code highlighting
                    and <code>title</code> as the name of the tab with the sample.
                    Here is a JavaScript request code sample:
                </p>
                <pre>
                    <code>
                        &lt;request&gt;
                        &lt;sample lang="javascript" title="JavaScript"&gt;
                        const data = {
                        id: 123,
                        name: "John Doe",
                        email: "john.doe@example.com"
                        };
                        &lt;/sample&gt;
                        &lt;/request&gt;
                    </code>
                </pre>

                <p>
                    If you store samples in a separate file you can specify it in the
                    <code>src</code>
                    and even reference specific lines from it using the <code>include-lines</code> attribute.
                </p>
                <pre>
                    <code>
                        &lt;response&gt;
                        &lt;sample src="example.js" include-lines="5-10"/&gt;
                        &lt;/response&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="lang" type="xs:string" default="JSON">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the language for highlighting in this sample.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="src" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the source file with code that you want to include as a sample.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="include-lines" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify line numbers from the source file to include in the sample.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="title" type="xs:string" default="JSON example"/>
        </xs:complexType>
    </xs:element>
    <xs:element name="api-schema">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Define data objects or schemas within your API documentation.
                    This tag is particularly useful for documenting the structure and details of nested data objects.
                </p>
                <p>
                    The <code>&lt;api-schema&gt;</code> tag accepts several attributes to provide context and reference
                    to
                    external specifications:
                </p>

                <ul>
                    <li>
                        <code>openapi-path</code>: specifies the path to an OpenAPI file with schema definitions.
                    </li>
                    <li>
                        <code>name</code>: defines the schema name as it is defined in
                        <code>components.schemas</code>
                        (for openAPI 3.0) or <code>definitions</code> (for swagger 2.0).
                    </li>
                </ul>

                <pre>
                    <code>&lt;api-schema openapi-path="path/to/spec.yaml" name="User"/&gt;</code>
                </pre>

                <p>
                    The previous example will generate a reference for the <code>User</code> object.
                </p>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="display-links-if-available" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether to display links to corresponding API schema objects when possible.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="openapi-path" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the path to the OpenAPI specification with schema definitions.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="name" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the schema name as it is defined in <code>components.schemas</code> (for openAPI 3.0)
                            or <code>definitions</code> (for swagger 2.0).
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="depth" use="optional"/>
        </xs:complexType>
    </xs:element>


    <xs:element name="tabs">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Separate related groups of content into switchable tabs.
                    For example, instructions for different operating systems, languages, roles, and so on.
                </p>
                <p>
                    The <code>&lt;tabs&gt;</code> element must contain at least two <code>&lt;tab&gt;</code> elements,
                    each with a <code>title</code> attribute:
                </p>
                <pre>
                    <code>
                        &lt;tabs&gt;
                        &lt;tab title="Foo"&gt;Content of tab Foo&lt;/tab&gt;
                        &lt;tab title="Bar"&gt;Content of tab Bar&lt;/tab&gt;
                        &lt;/tabs&gt;
                    </code>
                </pre>

                <p>
                    Alternatively, you can use <code>&lt;code-block&gt;</code> elements
                    instead of <code>&lt;tab&gt;</code> elements
                    to show code blocks separated into tabs by language name.
                    In this case, make sure that all <code>&lt;code-block&gt;</code> elements
                    define their <code>lang</code> attribute,
                    and languages do not repeat:
                </p>
                <pre>
                    <code>
                        &lt;tabs&gt;
                        &lt;code-block lang="java"&gt;Java code&lt;/code&gt;
                        &lt;code-block lang="groovy"&gt;Groovy code&lt;/code&gt;
                        &lt;/tabs&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:choice>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                <xs:element ref="tab" maxOccurs="unbounded" minOccurs="2"/>
                <xs:element ref="code-block" maxOccurs="unbounded" minOccurs="2"/>
            </xs:choice>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="group" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the synchronization group to which these tabs should belong.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="link-summary">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Provide some text to display as a topic or chapter summary inside a link popup that shows on mouse
                    hover.
                    The popup renders as plain text, so formatting is not allowed inside <code>
                    &lt;link-summary&gt;</code>.
                </p>
                <p>
                    By default, the popup on a link renders the first paragraph of a topic.
                    However, if you want to override it, define a <code>&lt;link-summary&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;link-summary&gt;
                        This topic is about Foo.
                        This text will not render in the topic.
                        It is used only in the link popup.
                        &lt;/link-summary&gt;
                        &lt;/topic&gt;
                    </code>
                </pre>

                <p>
                    You can use an existing element with an <code>id</code> as a summary (for example, any paragraph).
                    To do this, refer to the <code>id</code> using the <code>rel</code> attribute in <code>&lt;link-summary&gt;</code>:
                </p>
                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;p id="intro"&gt;
                        This topic is about Foo.
                        This text will render as a regular paragraph.
                        &lt;/p&gt;

                        &lt;link-summary rel="intro"/&gt;
                        &lt;/topic&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="rel"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="tab">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Define at least two tabs inside the <code>&lt;tabs&gt;</code> element,
                    each with a unique <code>title</code> attribute:
                </p>
                <pre>
                    <code>
                        &lt;tabs&gt;
                        &lt;tab title="Foo"&gt;Content of tab Foo&lt;/tab&gt;
                        &lt;tab title="Bar"&gt;Content of tab Bar&lt;/tab&gt;
                        &lt;/tabs&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group ref="TabChildElements" maxOccurs="unbounded" minOccurs="0"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="title" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="group-key" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the key within the synchronization group,
                            which is defined by the <code>group</code> attribute in <code>&lt;tabs&gt;</code>.
                            When your reader opens this tab,
                            it will also open all tabs marked by this key in the same synchronization group.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="tldr">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Document the most important simple "facts" about the subject of the topic or chapter:
                    the shortcut to use the described feature, path to the relevant settings,
                    critical prerequisites, an illustrative example, and so on.
                </p>
                <p>
                    Each "fact" is formatted as a separate paragraph inside a <code>&lt;p&gt;</code> element.
                    Keep them simple, short, and concise.
                    They are not meant for explaining complex concepts,
                    but rather to give the user quick guidance for exploring the feature themselves.
                </p>
                <p>
                    This block will be rendered at the very beginning of the topic or chapter,
                    directly below the title.
                </p>
                <pre>
                    <code>
                        &lt;tldr&gt;
                        &lt;p&gt;&lt;ui-menu&gt;File | Save&lt;/ui-menu&gt; or &lt;shortcut&gt;Ctrl + S&lt;/shortcut&gt;&lt;/p&gt;
                        &lt;p&gt;You can't save if the file is open in another application&lt;/p&gt;
                        &lt;/tldr&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence maxOccurs="unbounded" minOccurs="0">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="p" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="if">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Filter out content based on product, platform, or a custom filter.</p>

                <pre>
                    <code>
                        &lt;p&gt;
                        This &lt;if instance="SimpleApp"&gt;word&lt;/for&gt;&lt;if instance="OtherApp"&gt;weird phrase&lt;/for&gt;
                        will be different depending on the instance.
                        &lt;/p&gt;
                    </code>
                </pre>

                <p>
                    You can wrap any elements inside <code>&lt;if&gt;</code>.
                    For example, in a <code>&lt;snippet&gt;</code>, you can use <code>&lt;if&gt;</code> for filtering:
                </p>

                <pre>
                    <code>
                        &lt;if filter="advanced"&gt;
                        &lt;p&gt;For example:&lt;/p&gt;

                        &lt;list&gt;
                        &lt;li&gt;Like&lt;/li&gt;
                        &lt;li&gt;this&lt;/li&gt;
                        &lt;/list&gt;
                        &lt;/if&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group ref="ForElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="var">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Define a variable anywhere inside a topic by specifying its name and value:</p>

                <pre>
                    <code>
                        &lt;var name="myvar" value="Hello"/&gt;
                    </code>
                </pre>

                <p>
                    You can refer to this variable throughout the topic as <code>%myvar%</code>.
                    If you define the same variable's value multiple times, it will use the last defined value.
                </p>
                <p>
                    Use variables to render repeating elements, such as the name of your product or a directory path.
                    You can filter the variable by products:
                </p>

                <pre>
                    <code>
                        &lt;var name="product" value="Foo Sprinkler" instance="foo"/&gt;
                        &lt;var name="product" value="Bar Annotator" instance="bar"/&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="value" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="name" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the name of this variable.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="value" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the value of this variable.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="default" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify an optional default value for this variable.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="value">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify the value of a variable.
                    For a single value, you can use the <code>value</code> attribute in <code>&lt;var&gt;</code>.
                    However, if you need to conditionalize values, add them as child elements:
                </p>

                <pre>
                    <code>
                        &lt;var name="my_var"&gt;
                        &lt;value instance="foo"&gt;value for foo&lt;/value&gt;
                        &lt;value instance="bar"&gt;value for bar&lt;/value&gt;
                        &lt;/var&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:attribute name="element-id" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the element ID.</p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="property">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the property key from a specific resource bundle:</p>

                <pre>
                    <code>
                        &lt;property bundle="FooBundle" key="some.property.string"/&gt;
                    </code>
                </pre>

                <p>
                    This will render the relevant key value,
                    which is helpful for UI strings extracted from your product.
                </p>
                <p>
                    If the property contains variables,
                    you can pass their values using the <code>args</code> attribute.
                </p>
                <p>
                    If you need to specify a property from a resource bundle for a specific product,
                    use the <code>from-product</code> attribute.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="bundle" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the property bundle name.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="key" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the property key from the bundle.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="args" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            For properties with variables (<code>{0}</code>, <code>{1}</code>, and so on),
                            specify a comma-separated list of values.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="cleanup-mode" use="optional" type="PropertyCleanupType">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the mode for cleaning up property values if they contain some special characters.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="cleanup-pattern" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify a regex pattern to clean up from property values,
                            for example, <code>[…_]</code> to match all ellipsis and underscore characters.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="from-product" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the product to force for choosing the property bundle.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="PropertyCleanupType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="default"/>
            <xs:enumeration value="override"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="topic">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Wrap all topics with this top-level element that defines important topic attributes:</p>

                <list>
                    <li>
                        <code>title</code>
                        specifies the title of the topic
                    </li>
                    <li>
                        <code>id</code>
                        specifies a unique identifier for the topic
                    </li>
                    <li>
                        <code>help-id</code>
                        specifies an additional context help identifier to reference this topic from a related UI in the
                        product
                    </li>
                    <li>
                        <code>switcher-label</code>
                        specifies the label for the <code>&lt;switcher-key&gt;</code> (by default, it is labeled as
                        "Section")
                    </li>
                    <li>
                        <code>is-library</code>
                        specifies whether this is a library of content snippets (by default, set to <code>false</code>)
                    </li>
                    <li>
                        <code>xsi:noNamespaceSchemaLocation</code>
                        specifies the location of the XML schema
                    </li>
                </list>

                <p>Example:</p>

                <pre>
                    <code>
                        &lt;topic
                        xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
                        title="How to play the drums"
                        id="drum-guide"
                        help-id="drums.dialog"
                        switcher-label="Level"&gt;

                        &lt;p&gt;Hit the drums with sticks.&lt;/p&gt;
                        ...
                        &lt;/topic&gt;
                    </code>
                </pre>

            </xs:documentation>
        </xs:annotation>

        <xs:complexType mixed="false">
            <xs:choice>
                <xs:element ref="section-starting-page" minOccurs="1" maxOccurs="1"/>

                <xs:sequence minOccurs="0" maxOccurs="1">
                    <xs:element ref="help-id" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="web-file-name" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="contribute-url" maxOccurs="1" minOccurs="0"/>
                    <xs:element ref="show-structure" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="no-index" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="title" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="web-summary" maxOccurs="1" minOccurs="0"/>
                    <xs:element ref="include-in-head" maxOccurs="unbounded" minOccurs="1"/>
                    <xs:element ref="tldr" minOccurs="0" maxOccurs="1"/>
                    <xs:element ref="card-summary" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="primary-label" minOccurs="0" maxOccurs="1"/>
                    <xs:element ref="secondary-label" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:choice maxOccurs="unbounded" minOccurs="1">
                        <xs:element ref="link-summary" maxOccurs="1" minOccurs="0"/>
                        <xs:group ref="HighLevelElements" minOccurs="0" maxOccurs="unbounded"/>
                        <xs:element ref="seealso" maxOccurs="1" minOccurs="0"/>
                    </xs:choice>
                </xs:sequence>
            </xs:choice>

            <xs:attribute ref="id"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="title" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="switcher-label" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify a label for the custom content switcher in the header.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="is-library" use="optional" type="xs:boolean" default="false">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Mark this topic as a library of reusable snippets,
                            not used as an actual topic in any help instance.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="last-modified" use="optional" type="xs:string" default="git">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the last modified date of this topic in the following format: <code>
                            YYYY-MM-DD</code>.
                            By default, if you do not provide an explicit date for a topic file,
                            Writerside will look for a date in the timestamps file.
                            If there is no date in the timestamps file,
                            it will then try to get the last modification date based on the Git history.
                            If this is not a Git repository,
                            then Writerside will fall back to the last modification date from the file system.
                        </p>
                        <p>
                            You can also force the described behavior by specifying
                            <code>last-modified="git"</code>
                            or <code>last-modified="file"</code> instead of a specific date.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="help-id">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify a unique context help identifier to reference this topic from a related dialog in the
                    product.
                    The same identifier must be assigned to the corresponding interface in the product's sources.
                    This will generate a redirect in the output
                    pointing from this help ID to the element where you specified it.
                </p>

                <pre>
                    <code>&lt;help-id&gt;some.help.id&lt;/help-id&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:attribute name="help-id" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the ID for redirects from your product to specific topics and chapters in your help
                    instance.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="emphasis">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Mark emphasized text to display it in <i>italic</i> and pronounce it with an emphasis by a screen
                    reader.
                    Use it to stress out a certain word or phrase, or introduce new terms, names, concepts, and so on.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="i" substitutionGroup="emphasis"/>

    <xs:element name="format" type="FormatElementKind">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Change the font style and color of text.
                    It is not recommended to format text directly.
                    Use semantic markup elements, such as
                    <code>&lt;control&gt;</code>
                    for UI controls,
                    <code>&lt;code&gt;</code>
                    for inline pieces of code,
                    and <code>&lt;path&gt;</code> for paths and file names.
                </p>

                <p>However, you can do it if necessary. Examples:</p>
                <pre>
                    <code>&lt;format style="bold,italic" color="RosyBrown"&gt;Hello, world!&lt;/format&gt;</code>
                </pre>
                <pre>
                    <code>&lt;format style="subscript" color="Red"&gt;Hello, world!&lt;/format&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:complexType name="FormatElementKind">
        <xs:sequence>
            <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="style" type="xs:string">
            <xs:annotation>
                <xs:documentation xml:lang="en">
                    <p>Specify the font style attributes separated by commas.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="color" type="xs:string">
            <xs:annotation>
                <xs:documentation xml:lang="en">
                    <p>Specify the font color.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attributeGroup ref="commons"/>
        <xs:attributeGroup ref="commons-visual"/>
        <xs:attribute ref="ignore-vars" use="optional"/>
    </xs:complexType>

    <xs:element name="category">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the category for a group of links in the <code>&lt;seealso&gt;</code> section.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:element ref="a" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="resource" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="res" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="snippet" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="include" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute ref="ref" use="required"/>
            <xs:attribute ref="sorted" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="ImageAlignKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="middle"/>
            <xs:enumeration value="top"/>
            <xs:enumeration value="bottom"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="a" type="ABaseElement">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a hyperlink to another topic or an arbitrary URL.
                    The link can be plain text, an image, a shortcut, or a property value.
                </p>

                <p>Link to a topic and render the topic title as the text of the link:</p>

                <pre>
                    <code>&lt;a href="my-topic.topic"/&gt;</code>
                </pre>

                <p>Link to a topic and specify the text of the link:</p>

                <pre>
                    <code>&lt;a href="my-topic.topic"&gt;Link text&lt;/a&gt;</code>
                </pre>

                <p>Link to a specific anchor in the target topic:</p>

                <pre>
                    <code>&lt;a href="my-topic.topic" anchor="intro"&gt;Link to anchor&lt;/a&gt;</code>
                </pre>

                <p>
                    An anchor can be any element's <code>id</code> attribute
                    or an explicit <code>&lt;anchor&gt;</code> element with a <code>name</code>.
                </p>

                <p>You can omit the <code>href</code> attribute when linking to an anchor inside the same topic.
                </p>

                <p>
                    Set <code>nullable="true"</code> to render just the link text without the actual hyperlink
                    if the target topic is not available when building your help.
                    Otherwise, the target topic must exist to avoid build failures.
                </p>

                <p>To add an external hyperlink, specify the full target URL in the <code>href</code> attribute:
                </p>

                <pre>
                    <code>&lt;a href="https://www.jetbrains.com"&gt;Link to the JetBrains website&lt;/a&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="card">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a card to a <code>&lt;section-starting-page&gt;</code>.
                    Cards are links to existing topics.
                    They can have an icon or a custom image.
                    By default, a card displays the default <code>&lt;link-summary&gt;</code> as text,
                    but you can override it using the <code>summary</code> attribute.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute ref="ignore-vars"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="alt" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the alternative text for the image or icon of a card.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="image" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify a custom image for the card.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="icon" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify a custom icon for the card.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="badge" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify one of the built-in icon badges for the card.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="href" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the link target: either a topic file name or an external URL.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="summary" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Override the link summary.
                            By default, when you hover over an internal link,
                            Writerside shows a popup with the first paragraph of the target topic or chapter.
                            You can also use the <code>&lt;link-summary&gt;</code> element
                            inside the topic or chapter to define a different link summary.
                            This attribute will override everything for this specific link.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="nullable" use="optional" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Render just the link text without the actual hyperlink
                            if the target topic is not available when building your help.
                            For example, if a referenced topic is included only in one help instance,
                            then you do not want a non-working link for the other help instance.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="anchor" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the ID of an element from the target topic.
                            For example, if you want to link to a specific chapter.
                            You can also use standard URL notation for anchors:
                        </p>
                        <pre>
                            <code>
                                &lt;a href="some.topic#this_chapter"/&gt;
                            </code>
                        </pre>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="type" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the type of the card in the spotlight group of a section starting page.
                            The card type defines the icon used for it.
                        </p>
                        <p>
                            This does not affect regular links.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="caps"/>
            <xs:attribute ref="target-switcher-key"/>
        </xs:complexType>
    </xs:element>

    <xs:attribute name="target-switcher-key" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify the <code>switcher-key</code> from the target topic,
                    if you want the link to open with a non-default switcher value.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="res">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    DEPRECATED: use the <code>resource</code> element
                    and reference files directly via the <code>src</code> attribute.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute name="resource-id" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            DEPRECATED: use the <code>resource</code> element
                            and reference files directly via the <code>src</code> attribute.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="resource">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a link to a file that the reader can download.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="src" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the name of the file from the resources directory.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="tooltip">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Show a tooltip with the definition of a term from the glossary on mouse hover.</p>

                <pre>
                    <code>&lt;p&gt;Choose your &lt;tooltip term="OS"&gt;OS&lt;/tooltip&gt;.&lt;/p&gt;</code>
                </pre>

                <p>
                    If you have the <code>&lt;term name="OS"&gt;</code> defined in <code>glossary.xml</code>,
                    the definition will pop up when you hover the mouse pointer over <code>OS</code> in the mentioned
                    paragraph.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="term" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the term from the glossary.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="s">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Mark text as incorrect, inaccurate, or irrelevant
                    and display it with a <s>red background</s> line through it.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="u">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Mark text as <u>underlined</u>.
                    Use it only if there is no alternative element that's more appropriate sematically.
                    In general, you should avoid it where it could be confused for a hyperlink.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="sub">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Mark text as <sub>subscript</sub> that appears half a character below the normal line.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="sup">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Mark text as <sup>subscript</sup> that appears half a character above the normal line.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="path">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Mark text as a file name or a path in the file system.</p>

                <pre>
                    <code>&lt;p&gt;Specify the configuration file: &lt;path&gt;path/to/config&lt;/path&gt;&lt;/p&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:attribute name="id" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify an identifier for an element:</p>

                <pre>
                    <code>&lt;p id="intro"&gt;This is an introduction.&lt;/p&gt;</code>
                </pre>

                <p>You can use this identifier as an anchor for a link:</p>

                <pre>
                    <code>&lt;a href="topic.topic" anchor="intro"&gt;Link to intro&lt;/a&gt;</code>
                </pre>

                <p>You can also include the whole element via its identifier:</p>

                <pre>
                    <code>&lt;include from="topic.topic" element-id="intro"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="ref" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Reference the category by its ID.</p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="use-when" type="xs:string"/>

    <xs:simpleType name="ImageTypeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="inline"/>
            <xs:enumeration value="block"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="img">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add an image, for example: a screenshot, an icon, or a diagram.
                    Use the <code>src</code> attribute to specify the name of the image file.
                    Use the <code>alt</code> attribute to describe the image:
                    this makes your documentation more accessible for users of screen readers
                    and provides additional information about your content for search engines.
                </p>

                <pre>
                    <code>&lt;img src="screenshot.png" alt="A screenshot of the Add dialog."/&gt;</code>
                </pre>

                <p>
                    Use the <code>width</code> attribute to resize the rendered image if necessary.
                    By default, it will resize the height proportionally,
                    but you can explicitly set the height using the <code>height</code> attribute.
                </p>

                <p>
                    <b>Inline vs block images</b>
                </p>

                <p>
                    Any small image (16 pixels or less) is considered an inline icon that should go into a paragraph.
                    If you put it outside of a paragraph, you will get a warning.
                    To insert a small image as a separate block element, set <code>type="block"</code> for it.
                </p>
                <p>
                    Images larger than 16 pixels are considered separate block elements by default.
                    If you try to inline it into a paragraph, you will get a warning.
                    To insert a large image into a paragraph, set <code>type="inline"</code> for it.
                </p>

                <p>
                    <b>Thumbnails</b>
                </p>

                <p>
                    If you have a very large image with a lot of details, by default, it will be scaled down to fit the
                    viewport (706 pixels).
                    To avoid this, set <code>thumbnail="true"</code>, which will generate and insert a small thumbnail
                    of the image that the reader can click to expand and view at full size.
                </p>
                <p>
                    Alternatively, you can specify a custom preview image instead of the automatically generated small
                    thumbnail using the <code>preview-src</code> attribute.
                </p>

                <p>
                    <b>Animated GIFs</b>
                </p>

                <p>
                    Writerside will automatically detect an animated GIF and insert the first frame that the user can
                    click to run the animation.
                    Instead of the first frame, you can specify a custom preview image
                    using the <code>preview-src</code> attribute.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="src" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the name of the image file from the designated images directory or its
                            subdirectories.
                            Completion always suggests these files before any others.
                        </p>

                        <pre>
                            <code>&lt;img src="image.png" alt="Alt text" width="450"/&gt;</code>
                        </pre>

                        <p>
                            You can specify the path to any image file in your project
                            relative to the current topic file
                            using the <code>./</code> and <code>../</code> notations.
                            In this case, you will see helpful path completion suggestions.
                        </p>

                        <pre>
                            <code>&lt;img src="../myMediaDir/image.png" alt="Alt text" width="450"/&gt;</code>
                        </pre>

                        <p>
                            You can use <code>$PROJECT_DIR$</code> and <code>$WRS_MODULE$</code> to reference
                            images relative to the documentation project or module root.
                        </p>

                        <pre>
                            <code>&lt;img src="$PROJECT_DIR$/allImages/image.png" alt="Alt text" width="450"/&gt;</code>
                        </pre>

                        <p>
                            You can also specify a URL to a file hosted somewhere on the web.
                            In this case, make sure that the file is accessible
                            from where you are going to host your documentation.
                        </p>

                        <pre>
                            <code>&lt;img src="https://www.jetbrains.com/company/brand/img/jetbrains_logo.png" alt="Alt
                                text" width="450"/&gt;
                            </code>
                        </pre>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="alt" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the alternate text for an image.
                            This is a short description of the image,
                            which is rendered when the image cannot be displayed,
                            used by screen readers, and helps with search optimization.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="dark-src" type="xs:string" use="optional"/>
            <xs:attribute name="width" type="xs:long" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Set the width for the image.
                            By default, images are rendered in their actual size or shrink to fit the viewport.
                            The height is adjusted proportionally, unless you set it explicitly.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="height" type="xs:long" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Set the height for the image.
                            By default, images are rendered in their actual size or shrink to fit the viewport.
                            The width is adjusted proportionally, unless you set it explicitly.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="style" type="ImageTypeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Force the image to be rendered inline or as a separate block element.
                            By default, Writerside decides based on the image size:
                        </p>

                        <list>
                            <li>
                                Any image larger than 32 pixels is always rendered as a separate block element,
                                even if you put it inside a paragraph.
                                If you want to render a large image inline with the paragraph text,
                                set <code>style="inline"</code> to indicate your intent.
                            </li>
                            <li>
                                Any image up to 32 pixels located in a paragraph is considered an inline image,
                                and Writerside renders it inside the paragraph.
                                If you want to render a small image as a separate block,
                                set
                                <code>style="block"</code>
                                or put it outside the paragraph according to your intent.
                            </li>
                        </list>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="thumbnail" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Make this image expandable.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="scale" type="xs:integer" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Set the scale ratio for this image..</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="border-effect" use="optional"/>
            <xs:attribute name="preview-src" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the initial image to show for an expandable image.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute use="optional" default="light" type="DarkLightThemeKind" name="theme">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the theme in which to display the image.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>

    </xs:element>

    <xs:attribute name="border-effect" type="BorderEffectKind">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a border around the image or video
                    to prevent the edges from blending with the web page background.
                </p>
                <list>
                    <li>
                        <code>border-effect="none"</code>
                        is the default value, which does not add a border
                    </li>
                    <li>
                        <code>border-effect="line"</code>
                        adds a rectangular border along the edges
                    </li>
                    <li>
                        <code>border-effect="rounded"</code>
                        adds a border with rounded corners
                    </li>
                </list>
                <p>
                    GIF animations always have a border, so <code>none</code> is not applicable for them.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="icon">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                Insert an icon from the designated directory for icons defined in <code>buildprofiles.xml</code>.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="src" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        Specify the icon file.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="dark-src" type="xs:string" use="optional"/>
            <xs:attribute name="alt" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        Specify the alternate text for the icon.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="width" type="xs:long" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        Specify the width of the icon.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="height" type="xs:long" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        Specify the height of the icon.
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="web-file-name">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify the exact name for the web file that will be produced from this topic.
                    By default, Writerside takes the topic file name, converts all letters to lower case
                    and all special characters to dashes,
                    so <code>My_Topic.topic</code> becomes <code>my-topic.html</code>.
                    If you want it to be <code>My_Topic.html</code>,
                    add this:
                </p>

                <pre>
                    <code>&lt;web-file-name&gt;My_Topic.html&lt;/web-file-name&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commons"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="show-structure">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Configure the navigation component inside the topic.
                    By default, Writerside renders links to first-level chapters on the right side of the topic page.
                    If you want to have both chapter and procedure titles up to level 2, add this:
                </p>

                <pre>
                    <code>&lt;show-structure for="chapter,procedure" depth="2"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="for" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the elements allowed in the topic navigation component: chapters, procedures, or
                            both.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="depth" use="optional" type="xs:nonNegativeInteger">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the maximum header level allowed in the topic navigation component.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="no-index">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Mark the topics that you do not want to be indexed by search engines.</p>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="anchor">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>DEPRECATED: use the <code>id</code> attribute on the relevant element instead.
                </p>
                <p>Add an anchor to which you can create a hyperlink.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>DEPRECATED: use the <code>id</code> attribute on the relevant element instead.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="list">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a list of items.</p>

                <pre>
                    <code>
                        &lt;list&gt;
                        &lt;li&gt;List item&lt;/li&gt;
                        &lt;li&gt;Another list item&lt;/li&gt;
                        &lt;li&gt;One more list item&lt;/li&gt;
                        &lt;/list&gt;
                    </code>
                </pre>

                <p>
                    By default, lists are unordered and rendered in one column.
                    Use the <code>type</code> attribute to create a numbered list designated with numeric values
                    (1, 2, 3, ...) or letters (a, b, c, ...).
                    For example, if you need to describe numbered annotations on a screenshot
                    that mark various UI elements:
                </p>

                <pre>
                    <code>
                        &lt;list type="decimal"&gt;
                        &lt;li&gt;Editor&lt;/li&gt;
                        &lt;li&gt;File tree&lt;/li&gt;
                        &lt;li&gt;Status bar&lt;/li&gt;
                        &lt;/list&gt;
                    </code>
                </pre>

                <p>
                    However, if you are documenting an ordered sequence of steps (actions) to perform some task,
                    use the <code>&lt;procedure&gt;</code> element, not an ordered list.
                </p>
                <p>
                    If you have a long list of relatively short items, you can render the list in several columns by
                    setting the number of columns in the <code>columns</code> attribute.
                </p>

                <pre>
                    <code>
                        &lt;list columns="3"&gt;
                        &lt;li&gt;this&lt;/li&gt;
                        &lt;li&gt;is a&lt;/li&gt;
                        &lt;li&gt;list&lt;/li&gt;
                        &lt;li&gt;with&lt;/li&gt;
                        &lt;li&gt;many&lt;/li&gt;
                        &lt;li&gt;short&lt;/li&gt;
                        &lt;li&gt;items&lt;/li&gt;
                        &lt;li&gt;they&lt;/li&gt;
                        &lt;li&gt;will be&lt;/li&gt;
                        &lt;li&gt;rendered&lt;/li&gt;
                        &lt;li&gt;in three&lt;/li&gt;
                        &lt;li&gt;columns&lt;/li&gt;
                        &lt;/list&gt;
                    </code>
                </pre>

                <p>
                    Use the <code>sorted</code> attribute to sort the list items alphabetically
                    (either ascending or descending).
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="li" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <!-- DEPRECATED, use "type" attribute instead -->
            <xs:attribute name="style" type="ListKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>DEPRECATED: Use <code>type</code> instead.
                        </p>
                        <p>Specify whether this list should be numbered or bulleted.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="type" type="ListKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether this list should be numbered or bulleted.</p>

                        <list>
                            <li>
                                <code>type="bullet"</code>: use bullet points (default)
                            </li>
                            <li>
                                <code>type="decimal"</code>: use decimal digits (1, 2, 3, and so on)
                                when the order or total number of items is important
                            </li>
                            <li>
                                <code>type="alpha-lower"</code>: use letters (a, b, c, and so on)
                                for ordered nested lists
                            </li>
                            <li>
                                <code>type="none"</code>: render list without markers
                            </li>
                        </list>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="sorted" use="optional"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="start" type="xs:integer" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the first item number in a numbered list.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="columns" type="IntegerLimitType4" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Render the list in multiple columns.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="toc">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a list of links to child topics.
                </p>
                <p>
                    By default, it adds links to first-level subtopics of the current topic:
                </p>
                <pre>
                    <code>
                        &lt;toc/&gt;
                    </code>
                </pre>

                <p>
                    Use the <code>depth</code> attribute to specify the maximum nesting level of subtopics
                    that should be in the list.
                    For example, to use subtopics up to level 2:
                </p>

                <pre>
                    <code>
                        &lt;toc depth="2"/&gt;
                    </code>
                </pre>

                <p>
                    Use the <code>start-from</code> attribute to indicate a different topic
                    whose subtopics you want to list.
                </p>

                <pre>
                    <code>
                        &lt;toc start-from="another.topic"/&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attribute name="start-from" use="optional"/>
            <xs:attribute name="depth" use="optional"/>
            <xs:attributeGroup ref="commons"/>
        </xs:complexType>
    </xs:element>


    <xs:attribute name="sorted" type="SortKind">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Automatically sort items in a list or table when building your help instance.</p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="def">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a definition entry in a
                    <code>&lt;deflist&gt;</code>
                    with a mandatory <code>title</code> attribute (the name of the term).
                </p>

                <pre>
                    <code>
                        &lt;deflist&gt;
                        &lt;def title="Foo"&gt;Description of "Foo"&lt;/def&gt;
                        &lt;def title="Bar"&gt;Description of "Bar"&lt;/def&gt;
                        &lt;def title="Baz"&gt;Description of "Baz"&lt;/def&gt;
                        &lt;/deflist&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:element ref="title" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:group ref="DefListableElements" maxOccurs="unbounded" minOccurs="0"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute name="title" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="collapsible"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="default-state" type="InheritedCollapsibleDefaultStateKind">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            By default, all items of a collapsible definition list are collapsed.
                            Override this if you want some items to be expanded by default.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="InheritedCollapsibleDefaultStateKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="expanded"/>
            <xs:enumeration value="collapsed"/>
            <xs:enumeration value="inherited"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="SimpleListElementKind">
        <xs:complexContent mixed="true">
            <xs:extension base="xs:anyType">
                <xs:sequence minOccurs="0" maxOccurs="unbounded">
                    <xs:choice maxOccurs="unbounded" minOccurs="1">
                        <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                    </xs:choice>
                </xs:sequence>
                <xs:attributeGroup ref="commons"/>
                <xs:attributeGroup ref="commons-visual"/>
                <xs:attribute name="sorted" use="optional" type="SortKind">
                    <xs:annotation>
                        <xs:documentation xml:lang="en">
                            <p>Automatically sort items in a list or table when building your help instance.</p>
                        </xs:documentation>
                    </xs:annotation>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:element name="deflist">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a list of terms with their corresponding definitions (descriptions):</p>

                <pre>
                    <code>
                        &lt;deflist&gt;
                        &lt;def title="Foo"&gt;Description of "Foo"&lt;/def&gt;
                        &lt;def title="Bar"&gt;Description of "Bar"&lt;/def&gt;
                        &lt;def title="Baz"&gt;Description of "Baz"&lt;/def&gt;
                        &lt;/deflist&gt;
                    </code>
                </pre>

                <p>
                    A definition list is preferable to a table with two columns (name and description)
                    or a simple unordered list of terms and descriptions.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:element ref="title" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="def" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute name="sorted" use="optional" type="SortKind">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Automatically sort items in a list or table when building your help instance.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="type" use="optional" default="full" type="DeflistKind">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the width ratio between the definition and description.</p>

                        <list>
                            <li>
                                <code>type="full"</code>: render the definition title on a separate line (default)
                            </li>
                            <li>
                                <code>type="wide"</code>: render the definition title and the description side-by-side
                                with a 1:1 ratio.
                                This can be a good choice for a reference of REST API endpoints.
                            </li>
                            <li>
                                <code>type="medium"</code>: render the definition title and the description side-by-side
                                with a 1:2 ratio.
                                This can be a good choice for a reference of methods or functions.
                            </li>
                            <li>
                                <code>type="narrow"</code>: render the definition title and the description side-by-side
                                with a 2:7 ratio.
                                This can be a good choice for a reference of command-line options.
                            </li>
                            <li>
                                <code>type="compact"</code>: render the definition title and the description
                                side-by-side with a 1:8 ratio.
                                This can be a good choice for a reference of abbreviations or single-letter options.
                            </li>
                        </list>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <!-- DEPRECATED, use "type" attribute instead -->
            <xs:attribute name="style" use="optional" default="full" type="DeflistKind">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>DEPRECATED: Use <code>type</code> instead.
                        </p>
                        <p>Specify the ratio of the definition and description widths.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="CollapsibleElementAttributes"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="DeflistKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="compact"/>
            <xs:enumeration value="narrow"/>
            <xs:enumeration value="medium"/>
            <xs:enumeration value="wide"/>
            <xs:enumeration value="full"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:attribute name="collapsible" type="xs:boolean" default="false">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Make the chapter, procedure, or deflist collapsible.
                    By default, the element will appear collapsed with an icon to expand it.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="default-state" type="CollapsibleDefaultStateKind" default="collapsed">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    By default, a collapsible element is collapsed with an icon to expand it.
                    Override this if you want it to be expanded by default with the ability to collapse it if
                    necesssary.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attributeGroup name="CollapsibleElementAttributes">
        <xs:attribute ref="collapsible"/>
        <xs:attribute ref="default-state"/>
    </xs:attributeGroup>

    <xs:simpleType name="CollapsibleDefaultStateKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="collapsed"/>
            <xs:enumeration value="expanded"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:attribute name="lang" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the language for highlighting in this code block.</p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="compare">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Display two code blocks next to each other for comparison:</p>

                <pre>
                    <code>
                        &lt;compare&gt;
                        &lt;code-block lang="java"&gt;
                        public static void main(String[] args) {
                        System.out.println("Hi!");
                        }
                        &lt;/code-block&gt;
                        &lt;code-block lang="kotlin"&gt;
                        @JvmStatic fun main(args: Array&lt;String&gt;) {
                        println("Hi!")
                        }
                        &lt;/code-block&gt;
                        &lt;/compare&gt;
                    </code>
                </pre>

                <p>
                    By default, this displays the two code blocks side-by-side
                    with the first one titled "Before" and the second one titled "After".
                    Use the <code>type</code> attribute to change the arrangement to top-bottom.
                    Use the <code>first-title</code> and <code>second-title</code> attributes to change the titles.
                </p>

                <pre>
                    <code>
                        &lt;compare type="top-bottom" title-before="Java" title-after="Kotlin"&gt;
                        &lt;code-block lang="java"&gt;
                        public static void main(String[] args) {
                        System.out.println("Hi!");
                        }
                        &lt;/code-block&gt;
                        &lt;code-block lang="kotlin"&gt;
                        @JvmStatic fun main(args: Array&lt;String&gt;) {
                        println("Hi!")
                        }
                        &lt;/code-block&gt;
                        &lt;/compare&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:choice>
                <xs:element ref="code-block" maxOccurs="2" minOccurs="2"/>
                <!--                This is not supported yet, so let's not confuse users -->
                <!--                <xs:element ref="img" maxOccurs="2" minOccurs="2"/>-->
                <!--                <xs:element ref="list" maxOccurs="2" minOccurs="2"/>-->
            </xs:choice>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <!-- DEPRECATED, use "type" attribute instead -->
            <xs:attribute name="style" type="CodeCompareKind" default="left-right">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>DEPRECATED: Use <code>type</code> instead.
                        </p>
                        <p>Specify the layout of the comparison block: left-right or top-down.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="type" type="CodeCompareKind" default="left-right">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the layout of the comparison block: left-right or top-down.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="first-title" type="xs:string" default="Before">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title for the first code block in the comparison.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="second-title" type="xs:string" default="After">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title for the second code block in the comparison.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="code">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Format inline code fragments.
                    Use it to format names of keywords, variables, functions, methods, classes, properties, commands,
                    and so on.
                </p>

                <pre>
                    <code>&lt;p&gt;Use the &lt;code&gt;foo()&lt;code&gt; method to do something cool.&lt;/p&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="code-block">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a code fragment as a block of code.
                    Use the <code>lang</code> attribute to define the language of the code block:
                </p>
                <pre>
                    <code>
                        &lt;code-block lang="java"&gt;
                        public class Main {
                        public static void main() {
                        System.out.println("Here is some sample Java code.");
                        }
                        }
                        &lt;/code-block&gt;
                    </code>
                </pre>

                <p>
                    This will inject the code block adding code highlighting, formatting, and any other available
                    language-specific coding assistance.
                    It will also let the build engine know how to highlight this block in the output.
                    If you want a plain-text block, set <code>lang="plain text"</code>.
                    If you don't want to inject the code in the editor (for example, it's not a complete piece of code,
                    which produces syntax errors),
                    but still want to have proper highlighting for the specified language in the output,
                    set <code>noinject="true"</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars"/>
            <xs:attribute name="show-white-spaces" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Show spaces and tabs in the code block.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="include-symbol" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify a class, method, or another symbol from the source file to include in the code
                            block.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="include-lines" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify line numbers from the source file to include in the code block.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="src" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the source file with code that you want to include in the code block.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="prompt" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify a non-selectable prompt marker to use for rendering the code block.
                        </p>
                        <p>
                            For example, if the code block shows interaction with the command line,
                            specify a prompt that indicates the operating system or interpreter language,
                            such as <code>prompt=">>>"</code> or <code>prompt="$"</code>.
                            You can also indicate the current expected location context,
                            such as the host name and directory, for example:
                            <code>promt="username@hostname current-dir $"</code>.
                        </p>
                        <p>
                            If the code block contains a runnable command,
                            the prompt marker will help your readers understand this,
                            but it will not be copied with the command.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="lang" use="optional" default="Generic"/>
            <xs:attribute name="noinject" type="xs:boolean" default="false">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Do not inject the code.
                            By default, Writerside injects the specified language in the editor
                            to highlight, validate, and provide various assistance features directly in the code block
                            element.
                            If the code sample is not complete and valid, it will show a syntax error.
                            To avoid this, do not inject incomplete code samples
                            by specifying <code>noinject="true"</code>.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="CollapsibleElementAttributes"/>
            <xs:attribute name="collapsed-title" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify text to display when the code block is collapsed.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="collapsed-title-line-number" type="xs:integer" default="1">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the line number with text to display when the code block is collapsed.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="validate" type="xs:boolean" default="false">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Validate the code block when building the help instance.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="disable-links" type="xs:boolean" use="optional" default="false">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Do not treat triple square brackets as links <code>[[[JetBrains
                            website|https://www.jetbrains.com]]]</code>.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:attribute name="ignore-vars" type="xs:boolean" default="true">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Do not treat two percent characters with text between them <code>%foo%</code> as Writerside
                    variables.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="math">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Add an inline LaTeX formula or equation.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <!--xs:element name="math-block">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Add a LaTeX formula or equation block.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:element-->

    <xs:element name="td">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a cell to a table row <code>&lt;tr&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;table&gt;
                        &lt;tr&gt;
                        &lt;td&gt;First cell in the first row&lt;/td&gt;
                        &lt;td&gt;Second cell in the first row&lt;/td&gt;
                        &lt;td&gt;Third cell in the first row&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/table&gt;
                    </code>
                </pre>

                <p>
                    Use the <code>colspan</code> and <code>rowspan</code> attributes
                    to merge neighbouring cells in the corresponding column or row.
                </p>
                <p>
                    Use the <code>width</code> attribute in the top cell of any column
                    to define the width for the whole column.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:group ref="ServiceMarkupElements" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="BaseNoteElement" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="p" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="list" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="toc" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="deflist" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="code-block" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="compare" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="tabs" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="table" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="video" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute name="width" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Set the width for the column with this cell.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="sorted" use="optional" default="none"/>
            <xs:attribute name="colspan" use="optional" type="xs:long">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Span this cell across multiple columns.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="rowspan" use="optional" type="xs:long">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Span this cell across multiple rows.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="DarkLightThemeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dark"/>
            <xs:enumeration value="light"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="title">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Override the title of a topic, chapter, procedure, or any other element that can have a title.
                    In general, you define the title as an attribute for the corresponding element.
                    However, if you need different titles for different products, platforms, or sections,
                    use the <code>&lt;title&gt;</code> element as a child.
                </p>

                <pre>
                    <code>
                        &lt;chapter title="How to play drums" id="play_drums"&gt;

                        &lt;title instance="app"&gt;How to play drums like a pro&lt;/title&gt;

                        &lt;p&gt;
                        This topic will render with the title "How to play drums" for all instances except `app`,
                        where the title will be "How to play drums like a pro".
                        &lt;/p&gt;

                        &lt;/chapter&gt;
                    </code>
                </pre>

            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence maxOccurs="unbounded" minOccurs="0">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:element ref="icon" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute ref="caps"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="tr">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a row to a <code>&lt;table&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;table&gt;
                        &lt;tr&gt;
                        &lt;td&gt;First cell in the first row&lt;/td&gt;
                        &lt;td&gt;Second cell in the first row&lt;/td&gt;
                        &lt;td&gt;Third cell in the first row&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/table&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:element ref="td" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:group name="ServiceMarkupElements">
        <xs:sequence>
            <xs:choice minOccurs="1" maxOccurs="unbounded">
                <xs:element ref="if" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="include" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="snippet" minOccurs="0" maxOccurs="unbounded"/>
                <xs:element ref="var" minOccurs="0" maxOccurs="unbounded"/>
            </xs:choice>
        </xs:sequence>
    </xs:group>

    <xs:element name="table">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a table with rows <code>&lt;tr&gt;</code> and cells <code>&lt;td&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;table&gt;
                        &lt;tr&gt;
                        &lt;td&gt;First cell in the first row&lt;/td&gt;
                        &lt;td&gt;Second cell in the first row&lt;/td&gt;
                        &lt;td&gt;Third cell in the first row&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/table&gt;
                    </code>
                </pre>

                <p>
                    By default, the table dynamically adjusts the widths for columns depending on the content.
                    To define fixed widths, set the widths for the first cell in each column:
                </p>

                <pre>
                    <code>
                        &lt;table&gt;
                        &lt;tr&gt;
                        &lt;td width="100"&gt;First cell in the first row&lt;/td&gt;
                        &lt;td width="200"&gt;Second cell in the first row&lt;/td&gt;
                        &lt;td width="300"&gt;Third cell in the first row&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;/table&gt;
                    </code>
                </pre>

                <p>Use the <code>style</code> attribute to specify header rows and columns:
                </p>

                <list>
                    <li><code>header-row</code>: Use the first row as column headers (default)
                    </li>
                    <li><code>header-column</code>: Use the first column as row headers
                    </li>
                    <li><code>both</code>: Use both the first row and first column as headers
                    </li>
                    <li><code>none</code>: Do not highlight header rows or columns
                    </li>
                </list>

                <p>
                    Use the <code>cellpadding</code> attribute to specify the space between the border of table cells
                    and their content.
                </p>
                <p>
                    Use the <code>cellspacing</code> attribute to specify the space between table cells.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:element ref="tr" minOccurs="0" maxOccurs="unbounded"/>
                    <xs:group ref="ServiceMarkupElements" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="border" type="TableBorderTypeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether the table should have borders.</p>

                        <list>
                            <li><code>border="false"</code>: no borders
                            </li>
                            <li><code>border="true"</code>: all regular borders
                            </li>
                        </list>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="style" type="TableHeaderTypeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify which cells to use as the header for this table.</p>

                        <list>
                            <li><code>style="header-row"</code>: Use the first row as column headers (default)
                            </li>
                            <li><code>style="header-column"</code>: Use the first column as row headers
                            </li>
                            <li><code>style="both"</code>: Use both the first row and first column as headers
                            </li>
                            <li><code>style="none"</code>: Do not highlight any cells as headers
                            </li>
                        </list>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="column-width" type="TableColumnWidthModeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify whether table column widths should be fixed.
                            By default, column widths are automatically adjusted based on the content
                            and the size of the window.
                            If you want to ensure that the columns in a table have a consistent width,
                            set <code>column-width="fixed"</code>.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="width" type="xs:int" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the width of the table in pixels.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="TableBorderTypeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="false"/>
            <xs:enumeration value="true"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TableHeaderTypeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="header-row"/>
            <xs:enumeration value="header-column"/>
            <xs:enumeration value="both"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:attribute name="filter" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify a custom filter for an element.
                    When defining a <code>&lt;snippet&gt;</code>,
                    filter out content according to some criteria,
                    and then specify the <code>use-filter</code> attribute
                    on an <code>&lt;include&gt;</code> to reuse this snippet in different contexts.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:simpleType name="SeealsoStyleKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="links"/>
            <xs:enumeration value="cards"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TableColumnWidthModeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="auto"/>
            <xs:enumeration value="fixed"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CodeCompareKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="left-right"/>
            <xs:enumeration value="top-bottom"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="BorderEffectKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="rounded"/>
            <xs:enumeration value="line"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="video">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a video in a topic for illustrating a process.</p>

                <p>To embed a video from YouTube, specify a link to it in the <code>src</code> attribute:
                </p>

                <pre>
                    <code>&lt;video src="https://youtu.be/R8QW8s4Ibio"/&gt;</code>
                </pre>

                <p>
                    To add a video stored in the project files,
                    specify the file name in the <code>src</code> attribute:
                </p>

                <pre>
                    <code>&lt;video src="titanic_rip.mp4"/&gt;</code>
                </pre>

                <p>
                    The file must be stored in the <code>images</code> directory
                    along with a preview image of the same name.
                    For example, <code>titanic_rip.mp4</code> and <code>titanic_rip.png</code>.
                </p>
                <p>
                    Use the <code>width</code> and <code>height</code> attributes to change the size of the player.
                    If you set only one of the dimensions, the proportions are preserved.
                </p>
                <p>
                    Use the <code>mini-player</code> attribute to hide all video controls
                    except the Play and Pause buttons.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute ref="origin" use="optional"/>
            <xs:attribute ref="border-effect" use="optional"/>
            <xs:attribute name="src" type="xs:string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Specify the name or path to a local video file or a URL to a YouTube or Vimeo video.
                            For YouTube, you can use both the full and the shortened link formats.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="height" type="xs:integer" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Set the height for the video.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="width" type="xs:integer" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Set the width for the video.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="preview-src" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the initial image to show before the reader starts the video.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="mini-player" type="xs:boolean" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Use a minimalistic player for the video
                            with all controls hidden except the play and pause buttons.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="step">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a step to a procedure.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group ref="StepListableElements" maxOccurs="unbounded" minOccurs="0"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="procedure">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add an ordered list of steps describing how to perform a task.</p>
                <pre>
                    <code>
                        &lt;procedure title="Become a professional"&gt;
                        &lt;step&gt;Learn something&lt;/step&gt;
                        &lt;step&gt;Get paid for doing it&lt;/step&gt;
                        &lt;step&gt;(Optional) Do a barrel roll&lt;/step&gt;
                        &lt;/procedure&gt;
                    </code>
                </pre>

                <p>
                    The <code>title</code> attribute is optional
                    if the title of the procedure is obvious from the containing topic or chapter title.
                    Procedures without titles do not produce anchors
                    and do not appear in the in-topic table of contents.
                </p>
                <p>
                    You can add paragraphs before and after steps in a procedure
                    if you need to describe prerequisites, consequences, expected output,
                    and any other useful information that is not part of the actual steps.
                </p>
                <p>
                    Use the <code>default-state</code> attribute to make the procedure collapsible
                    and specify if it should initially be rendered as <code>collapsed</code> or <code>expanded</code>.
                </p>
                <p>
                    If there is only one step in the procedure,
                    it will be rendered with a bullet point instead of a numeric value.
                </p>
                <p>
                    If the procedure is a choice between several steps, set <code>type="choices"</code>.
                    Then all steps will be rendered as an unordered list with bullets.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:group ref="ProcedureElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="help-id" maxOccurs="unbounded" minOccurs="0"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
            <xs:attribute name="title" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="caps"/>
            <xs:attributeGroup ref="CollapsibleElementAttributes"/>
            <!-- DEPRECATED, use "type" attribute instead -->
            <xs:attribute name="style" type="ProcedureTypeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>DEPRECATED: Use <code>type</code> instead.
                        </p>
                        <p>Specify whether this procedure should be a sequence of steps or a choice.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="type" type="ProcedureTypeKind" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify whether this procedure should be a sequence of steps or a choice.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="p">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a paragraph.</p>

                <p>
                    Although the builder will add the necessary paragraphs,
                    it is recommended to always clearly distinguish paragraphs from other elements: images, lists, and
                    so on.
                    Don't leave text dangling outside of <code>&lt;p&gt;</code> tags.
                    Don't use <code>&lt;/br&gt;</code> to break content.
                    Separate content into paragraphs in chapters, tables, list items, definition list items, procedure
                    steps, tips, notes, and warnings.
                </p>
                <p>
                    To reference a paragraph with a link, as with any other element,
                    you can add the <code>id</code> attribute to it.
                </p>

                <pre>
                    <code>
                        &lt;p id="intro"&gt;
                        This is an introductory paragraph.
                        &lt;/p&gt;
                    </code>
                </pre>

                <p>You can add links to any element with an ID: <code>&lt;a anchor="intro"/&gt;</code>.
                </p>

                <p>Or include it: <code>&lt;include from="some.topic" element-id="intro"/&gt;</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="shortcut">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a shortcut by an identifier from a keymap file or hardcoded.</p>

                <pre>
                    <code>&lt;p&gt;To copy the selected text, press &lt;shortcut key="$Copy"/&gt;.&lt;/p&gt;</code>
                </pre>

                <pre>
                    <code>&lt;p&gt;To copy the selected text, press &lt;shortcut&gt;Ctrl+C&lt;/shortcut&gt;.&lt;/p&gt;
                    </code>
                </pre>

                <p>
                    If you have multiple keymap files,
                    there will be a switcher with available keymaps at the top of the page.
                    Shortcuts added via identifier keys will dynamically render from the selected keymap.
                    Hardcoded shortcuts will stay the same regardless of the selected keymap.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute name="from-keymap-of" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Use a shortcut defined in a keymap for another help instance.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="key" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the key of the action from the keymap definition file.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="force-layout" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Render the shortcut from the specified layout regardless of what the reader selects in the
                            shortcut switcher.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="ui-path">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a sequence of menu items or other clickable UI elements.</p>

                <pre>
                    <code>&lt;p&gt;From the main menu, select &lt;ui-path&gt;File | New | Project&lt;/ui-path&gt;.&lt;/p&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="BaseNoteElement" abstract="true">
        <xs:complexType mixed="true">
            <xs:group ref="NoteTags" maxOccurs="unbounded" minOccurs="0"/>
            <xs:attribute name="title" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="note" substitutionGroup="BaseNoteElement">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a note with important information
                    (restrictions, prerequisites, and possible problems that you think the user should be aware of).
                </p>

                <pre>
                    <code>&lt;note&gt;Only users with administrator privileges can perform this
                        operation.&lt;/note&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="tip" substitutionGroup="BaseNoteElement">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a tip with additional information
                    (alternatives, hints, and suggestions that may be helpful but not important for the task).
                </p>

                <pre>
                    <code>&lt;tip&gt;Alternatively, you can change the settings directly in the configuration file.&lt;/tip&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="warning" substitutionGroup="BaseNoteElement">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a warning with critical information about possible data loss,
                    physical, financial, or other kind of damage.
                </p>

                <pre>
                    <code>&lt;warning&gt;If you delete a user, all their transactions will also be erased from the
                        database.&lt;/warning&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="control">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a GUI element label, such as a button, a checkbox, or a dialog title.</p>

                <pre>
                    <code>&lt;p&gt;To show the recipe, select &lt;control&gt;Show recipe&lt;/control&gt; and click &lt;control&gt;OK&lt;/control&gt;.&lt;/p&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="b" substitutionGroup="control"/>

    <xs:element name="seealso">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add links to topics and external resources that may be relevant to the current topic.</p>

                <pre>
                    <code>
                        &lt;seealso&gt;
                        &lt;category ref="settings"&gt;
                        &lt;a href="drum_settings.topic"/&gt;
                        &lt;/category&gt;
                        &lt;category ref="external"&gt;
                        &lt;a href="https://blog.post.com/drums-are-cool"&gt;Why drums are cool&lt;/a&gt;
                        &lt;/category&gt;
                        &lt;/seealso&gt;
                    </code>
                </pre>

                <p>Separate links into categories defined in the <code>c.list</code> file.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence minOccurs="0" maxOccurs="unbounded">
                <xs:choice maxOccurs="unbounded" minOccurs="1">
                    <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="category" maxOccurs="unbounded" minOccurs="0"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute name="style" type="SeealsoStyleKind" use="optional" default="links">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Render this seealso block as a list of links or as cards with a title and summary.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="title" type="xs:string" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Custom title for the "See also" section. If not specified, the default "See also" will be
                            used.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:element name="li">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a list item.</p>

                <p>
                    Do not leave any dangling text inside list items:
                    wrap it with <code>&lt;p&gt;</code> elements to distinguish paragraphs.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:group ref="ListableElements" maxOccurs="unbounded" minOccurs="0"/>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="SortKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="asc"/>
            <xs:enumeration value="desc"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="include">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Reuse an element by its identifier.</p>

                <pre>
                    <code>&lt;include from="lib.topic" element-id="open-settings"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence maxOccurs="unbounded" minOccurs="0">
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attribute ref="origin"/>
            <xs:attribute name="from" use="required" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the topic from which you want to include content.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute ref="element-id"/>
            <xs:attribute name="nullable" use="optional" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Do not include anything if the source topic is not available in the current context.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="use-filter" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>
                            Insert content with conditions:
                            only content marked by the specified custom filters, separated with commas.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>

    <xs:attribute name="origin" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>If you want to include or reference something from another help module, specify this module as the
                    origin.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:simpleType name="ListKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="alpha-lower"/>
            <xs:enumeration value="bullet"/>
            <xs:enumeration value="decimal"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ProcedureTypeKind">
        <xs:restriction base="xs:string">
            <xs:enumeration value="steps"/>
            <xs:enumeration value="choices"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IntegerLimitType4">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1"/>
            <xs:maxExclusive value="5"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="VersionRefKind">
        <xs:restriction base="xs:string">
            <xs:pattern value="([0-9]){1,4}\.([0-9]){1,4}(\.([0-9]){1,4})*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InstanceIdListKind">
        <xs:restriction base="xs:string">
            <xs:pattern value="!*(\d+)(,\s*\d+)*"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:attribute name="version" type="VersionRefKind"/>

    <xs:attribute name="category" type="xs:string"/>

    <xs:attributeGroup name="commons">
        <xs:attribute ref="filter"/>
        <xs:attribute ref="id"/>
        <xs:attribute ref="instance"/>
    </xs:attributeGroup>

    <xs:attributeGroup name="commons-visual">
        <xs:attribute name="switcher-key" type="xs:string">
            <xs:annotation>
                <xs:documentation xml:lang="en">
                    <p>
                        Specify the switcher key to which an element should apply.
                        Writerside renders a switcher in the header
                        to dynamically switch content depending on the user's environment, for example.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>

    <xs:attribute name="instance" type="InstanceIdListKind">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify the conditions for an element.
                    For example, you can define the help instances to which this element applies,
                    and then it will not be present for other help instances.
                    Or you can negate with <code>!</code> to specify help instances from which to exclude this element.
                </p>

                <pre>
                    <code>&lt;p instance="!foo,bar"&gt;This paragraph is for any help instance except "foo" and "bar".&lt;/p&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="depth" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Specify the max depth of objects representation</p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:attribute name="rel" type="xs:string">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Specify an ID of a paragraph to use as a <code>&lt;link-summary&gt;</code>,
                    <code>&lt;card-summary&gt;</code>, or
                    <code>&lt;web-summary&gt;</code>
                    instead of the default first paragraph.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:attribute>

    <xs:element name="snippet">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Define a chunk of content with more than one element to insert using the <code>&lt;include&gt;</code> element.
                </p>

                <pre>
                    <code>
                        &lt;snippet id="settings"&gt;
                        &lt;p&gt;You can change the following settings:&lt;/p&gt;

                        &lt;list&gt;
                        &lt;li&gt;Volume&lt;/li&gt;
                        &lt;li&gt;Brightness&lt;/li&gt;
                        &lt;li&gt;Dimensions&lt;/li&gt;
                        &lt;/list&gt;
                        &lt;/snippet&gt;
                    </code>
                </pre>

                <p>This chunk should reside in a library topic that you reference with the <code>from</code> attribute:
                </p>

                <pre>
                    <code>&lt;include from="lib.topic" element-id="settings"/&gt;</code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:choice minOccurs="1" maxOccurs="unbounded">
                    <xs:group ref="ForElements" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="web-summary">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Add a web description for the topic that will be used by search engines.
                    By default, search engines will display the first paragraph of a topic.
                    However, if you want to override it, define a <code>&lt;web-summary&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;web-summary&gt;
                        This topic is about Foo.
                        This text will not render in the topic.
                        It is used only in the meta web description.
                        &lt;/web-summary&gt;

                        ...
                        &lt;/topic&gt;
                    </code>
                </pre>

                <p>
                    You can use an existing element with an <code>id</code> as a summary (for example, any paragraph).
                    To do this, refer to the <code>id</code> using the <code>rel</code> attribute in <code>&lt;web-summary&gt;</code>:
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;p id="intro"&gt;
                        This topic is about Foo.
                        This text will render as a regular paragraph.
                        &lt;/p&gt;

                        &lt;web-summary rel="intro"/&gt;
                        &lt;/topic&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="rel"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="include-in-head">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Add a snippet of code that will be inserted into the <code>HEAD</code> section of HTML output generated from this article.
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;include-in-head&gt;
                        &lt;script type="application/ld+json"&gt;
                        {
                        "@context": "https://schema.org",
                        "@type": "FAQPage"
                        }
                        &lt;script&gt;
                        &lt;/include-in-head&gt;

                        ...
                        &lt;/topic&gt;
                    </code>
                </pre>

                <p>
                    You can use an existing element with an <code>id</code> as a summary (for example, any paragraph).
                    To do this, refer to the <code>id</code> using the <code>rel</code> attribute in <code>&lt;web-summary&gt;</code>:
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;p id="intro"&gt;
                        This topic is about Foo.
                        This text will render as a regular paragraph.
                        &lt;/p&gt;

                        &lt;web-summary rel="intro"/&gt;
                        &lt;/topic&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>

        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="rel"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="card-summary">
        <xs:annotation>
            <xs:documentation>
                <p>
                    Add a summary of the topic that will be displayed for cards in a <code>
                    &lt;section-starting-page&gt;</code>.
                    By default, it will render the first paragraph of a topic.
                    However, if you want to override it, define a <code>&lt;card-summary&gt;</code>.
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;card-summary&gt;
                        This topic is about Foo.
                        This text will not render in the topic.
                        It is used only in cards on a section starting page.
                        &lt;/card-summary&gt;

                        ...
                        &lt;/topic&gt;
                    </code>
                </pre>

                <p>
                    You can use an existing element with an <code>id</code> as a summary (for example, any paragraph).
                    To do this, refer to the <code>id</code> using the <code>rel</code> attribute in <code>&lt;card-summary&gt;</code>:
                </p>

                <pre>
                    <code>
                        &lt;topic title="Foo" id="foo"&gt;
                        &lt;p id="intro"&gt;
                        This topic is about Foo.
                        This text will render as a regular paragraph.
                        &lt;/p&gt;

                        &lt;card-summary rel="intro"/&gt;
                        &lt;/topic&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="rel"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="description">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a description for the starting page of a section.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:group ref="ServiceMarkupElements" maxOccurs="unbounded" minOccurs="0"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="chapter">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>Add a chapter with a title and an identifier.</p>

                <pre>
                    <code>
                        &lt;chapter title="Do a barrel roll" id="barrel-roll"&gt;
                        &lt;p&gt;Whenever you are not sure what to do, try a barrel roll first, then ask for help.&lt;/p&gt;

                        ...
                        &lt;/chapter&gt;
                    </code>
                </pre>

                <p>
                    You can set the title as a child element <code>&lt;title&gt;</code>,
                    for example, if you want to have a custom chapter title depending on the product:
                </p>

                <pre>
                    <code>
                        &lt;chapter title="Do a barrel roll" id="barrel-roll"&gt;
                        &lt;title instance="anotherApp"&gt;Do another barrel roll&lt;/title&gt;
                        &lt;p&gt;Whenever you are not sure what to do, try a barrel roll first, then ask for help.&lt;/p&gt;

                        ...
                        &lt;/chapter&gt;
                    </code>
                </pre>

                <p>
                    You can add subchapters inside chapters.
                    The header level of the chapter depends on the chapter level.
                </p>
                <p>
                    To collapse a chapter by default, set <code>default-state="collapsed"</code>.
                    To make an expanded chapter collapsible, set <code>default-state="expanded"</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:choice maxOccurs="unbounded" minOccurs="0">
                    <xs:element ref="link-summary" maxOccurs="1" minOccurs="0"/>
                    <xs:element ref="title" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:group ref="ChapterElements" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="tldr" minOccurs="0" maxOccurs="1"/>
                    <xs:element ref="help-id" maxOccurs="unbounded" minOccurs="0"/>
                    <xs:element ref="primary-label" minOccurs="0" maxOccurs="1"/>
                    <xs:element ref="secondary-label" minOccurs="0" maxOccurs="unbounded"/>
                </xs:choice>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
            <xs:attributeGroup ref="commons-visual"/>
            <xs:attribute ref="help-id"/>
            <xs:attribute ref="caps"/>
            <xs:attribute name="title" use="optional" type="xs:string">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the title.</p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attribute name="level" use="optional">
                <xs:annotation>
                    <xs:documentation xml:lang="en">
                        <p>Specify the heading level from 2 to 6.
                            It is not recommended to set the heading level explicitly
                            because it will break the natural chapter hierarchy,
                            making it harder to follow structured content.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:attribute>
            <xs:attributeGroup ref="CollapsibleElementAttributes"/>
            <xs:attribute ref="ignore-vars" use="optional"/>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="NumbersOnly">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9\-]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType mixed="false" name="SectionGroupElementKind">
        <xs:sequence maxOccurs="unbounded" minOccurs="1">
            <xs:element ref="title" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="a" type="AWithTypeElement" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element ref="card" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attributeGroup ref="commons"/>
    </xs:complexType>

    <xs:complexType mixed="false" name="LinksGroupElementKind">
        <xs:sequence maxOccurs="unbounded" minOccurs="1">
            <xs:element ref="title" minOccurs="1" maxOccurs="unbounded"/>
            <xs:element name="a" type="ABaseElement" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attributeGroup ref="commons"/>
    </xs:complexType>

    <xs:element name="SectionGroupElementBase" abstract="true" type="SectionGroupElementKind"/>

    <xs:element name="primary" substitutionGroup="SectionGroupElementBase">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a group of cards with links to the most important topics in the section.
                    This is a child of the <code>&lt;section-starting-page&gt;</code> element.
                    Add a <code>&lt;title&gt;</code> and any number of links,
                    but preferably keep them between 4 and 8.
                </p>

                <pre>
                    <code>
                        &lt;primary&gt;
                        &lt;title&gt;Quick start&lt;/title&gt;
                        &lt;a href="Hello_World.topic" summary="Write your first Hello World program."&gt;Hello, World!&lt;/a&gt;
                        &lt;a href="Barrel_Roll.topic" summary="Learn how to do a barrel roll properly."&gt;Do a barrel
                        roll&lt;/a&gt;
                        ...
                        &lt;/primary&gt;
                    </code>
                </pre>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary,
                    unless the topic has a <code>&lt;card-summary&gt;</code> element defined.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="spotlight" substitutionGroup="SectionGroupElementBase">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a group of exactly two cards with links to featured topics in the section.
                    This is a child of the <code>&lt;section-starting-page&gt;</code> element.
                </p>
                <pre>
                    <code>
                        &lt;spotlight&gt;
                        &lt;a href="Try_This.topic" summary="If you haven't already, you should try it."&gt;Try this&lt;/a&gt;
                        &lt;a href="Important_Stuff.topic" summary="Learn what is most important when you begin."&gt;Important
                        stuff&lt;/a&gt;
                        &lt;/spotlight&gt;
                    </code>
                </pre>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary,
                    unless the topic has a <code>&lt;card-summary&gt;</code> element defined.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="secondary" substitutionGroup="SectionGroupElementBase">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a group of cards with links to topics in this section that you would like to highlight.
                    This is a child of the <code>&lt;section-starting-page&gt;</code> element.
                    Add a <code>&lt;title&gt;</code> and any number of links,
                    but preferably keep them between 2 and 4.
                </p>

                <pre>
                    <code>
                        &lt;secondary&gt;
                        &lt;title&gt;Migration guides&lt;/title&gt;
                        &lt;a href="migrate_from_foo.topic" summary="Switch from FooApp to our awesome product."&gt;Migrate
                        from FooApp&lt;/a&gt;
                        &lt;a href="migrate_from_bar.topic" summary="Switch from BarApp to our awesome product."&gt;Migrate
                        from BarApp&lt;/a&gt;
                        ...
                        &lt;/secondary&gt;
                    </code>
                </pre>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary,
                    unless the topic has a <code>&lt;card-summary&gt;</code> element defined.
                </p>
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:element name="cards">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a custom group of links to topics that you would additionally like to list on the starting page
                    of the section.
                    This is a child of the <code>&lt;misc&gt;</code> element in a <code>
                    &lt;section-starting-page&gt;</code>.
                    A group of cards must have a <code>&lt;title&gt;</code> and may have any number of links,
                    but preferably keep them between 2 and 6.
                </p>

                <pre>
                    <code>
                        &lt;misc&gt;
                        &lt;cards narrow="false"&gt;
                        &lt;title&gt;Other tools&lt;/title&gt;
                        &lt;a href="copy_cat.topic" summary="Copy any text from any document."&gt;Copy Cat&lt;/a&gt;
                        &lt;a href="paste_dog.topic" summary="Paste anything from the clipboard history."&gt;Paste Dog&lt;/a&gt;
                        ...
                        &lt;/cards&gt;
                        &lt;/misc&gt;
                    </code>
                </pre>

                <p>You can set <code>narrow="true"</code> to render three cards in a row.
                </p>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary,
                    unless the topic has a <code>&lt;card-summary&gt;</code> element defined.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:complexContent mixed="false">
                <xs:extension base="SectionGroupElementKind">
                    <xs:attribute name="narrow" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">
                                <p>Use three narrow columns for links instead of the default two wide columns.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="links">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add one or more custom groups of links to topics that you would additionally like to list on the
                    starting page of the section.
                    This is a child of the <code>&lt;misc&gt;</code> element in a <code>
                    &lt;section-starting-page&gt;</code>.
                </p>
                <p>
                    Use the <code>&lt;group&gt;</code> element to group separate link collections with a <code>&lt;title&gt;</code> and
                    any number of links in each group,
                    but preferably keep them between 2 and 4 in each collection.
                </p>

                <p>You can set <code>narrow="true"</code> to render the links in three columns (groups).
                </p>

                <pre>
                    <code>
                        &lt;misc&gt;
                        &lt;links narrow="true"&gt;
                        &lt;group&gt;
                        &lt;title&gt;Frameworks&lt;/title&gt;
                        &lt;a href="tupleconverter.topic" summary="Everything you need to convert tuples."&gt;TupleConverter&lt;/a&gt;
                        &lt;a href="img_edit.topic" summary="Automate your image editing needs."&gt;ImgEdit&lt;/a&gt;
                        ...
                        &lt;/group&gt;
                        ...
                        &lt;/links&gt;
                        &lt;/misc&gt;
                    </code>
                </pre>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary in a popup when you hover
                    over the link,
                    unless the topic has a <code>&lt;link-summary&gt;</code> element defined.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:complexContent mixed="false">
                <xs:extension base="LinksGroupElementKind">
                    <xs:sequence>
                        <xs:element ref="group" maxOccurs="unbounded" minOccurs="1"/>
                    </xs:sequence>
                    <xs:attribute name="narrow" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">
                                <p>Use three narrow columns for cards instead of the default two wide columns.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:extension>
            </xs:complexContent>
        </xs:complexType>
    </xs:element>

    <xs:element name="section-starting-page">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add a starting page for a section of topics.
                    Mandatory child elements are:
                </p>

                <list>
                    <li>
                        <code>&lt;title&gt;</code>
                        is the title of the section starting page
                    </li>
                    <li>
                        <code>&lt;description&gt;</code>
                        is a paragraph that briefly introduces the section
                    </li>
                    <li>
                        <code>&lt;spotlight&gt;</code>
                        defines two featured topics
                    </li>
                    <li>
                        <code>&lt;primary&gt;</code>
                        defines more topics that are important to read in this section
                    </li>
                    <li>
                        <code>&lt;secondary&gt;</code>
                        defines several more topics that you would like to highlight in a separate group
                    </li>
                </list>

                <p>You can also add the <code>&lt;misc&gt;</code> element to add any number of additional topic groups.
                </p>

                <pre>
                    <code>
                        &lt;section-starting-page&gt;
                        &lt;title&gt;This is the title&lt;/title&gt;
                        &lt;description&gt;Description of the starting page&lt;/description&gt;

                        &lt;spotlight&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        &lt;/spotlight&gt;

                        &lt;primary&gt;
                        &lt;title&gt;Main group title&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/primary&gt;

                        &lt;secondary&gt;
                        &lt;title&gt;highlighted group title&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/secondary&gt;

                        &lt;misc&gt;
                        &lt;cards narrow="false"&gt;
                        &lt;title&gt;Other tools&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/cards&gt;

                        &lt;links narrow="true"&gt;
                        &lt;group&gt;
                        &lt;title&gt;Frameworks&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/group&gt;
                        ...
                        &lt;/links&gt;
                        &lt;/misc&gt;
                        &lt;/section-starting-page&gt;
                    </code>
                </pre>
            </xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="false">
            <xs:sequence>
                <xs:element ref="title"/>
                <xs:element ref="description"/>
                <xs:element ref="spotlight" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="primary" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="secondary" minOccurs="0" maxOccurs="1"/>
                <xs:element ref="misc" minOccurs="0" maxOccurs="1"/>
            </xs:sequence>
            <xs:attributeGroup ref="commons"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="misc">
        <xs:annotation>
            <xs:documentation xml:lang="en">
                <p>
                    Add custom groups of cards and links to topics that you would additionally like to list on the
                    starting page of the section.
                    This is a child of the <code>&lt;section-starting-page&gt;</code> element.
                </p>

                <pre>
                    <code>
                        &lt;misc&gt;
                        &lt;cards narrow="false"&gt;
                        &lt;title&gt;Other tools&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/cards&gt;

                        &lt;links narrow="true"&gt;
                        &lt;group&gt;
                        &lt;title&gt;Frameworks&lt;/title&gt;
                        &lt;a href="some_topic.topic" summary="First topic summary."&gt;Some topic&lt;/a&gt;
                        &lt;a href="some_other_topic.topic" summary="Second topic summary."&gt;Some other topic&lt;/a&gt;
                        ...
                        &lt;/group&gt;
                        ...
                        &lt;/links&gt;
                        &lt;/misc&gt;
                    </code>
                </pre>

                <p>
                    If you don't provide the <code>summary</code> attribute,
                    it will render the first paragraph of the referenced topic as a summary on the card or a popup on
                    the link,
                    unless the topic has a <code>&lt;card-summary&gt;</code> and <code>&lt;link-summary&gt;</code> elements
                    defined.
                </p>
            </xs:documentation>
