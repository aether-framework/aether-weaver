<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bill of materials. Consumers import this to get a consistent set of Aether Weaver versions
  without repeating <version> on every dependency. Aether family convention.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.splatgames.aether.weaver</groupId>
        <artifactId>aether-weaver</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>aether-weaver-bom</artifactId>
    <packaging>pom</packaging>

    <name>aether-weaver-bom</name>
    <description>Bill of materials for the Aether Weaver artifacts.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.splatgames.aether.weaver</groupId>
                <artifactId>aether-weaver-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
